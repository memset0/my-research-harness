{
  "name": "memon-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "memon — experiment monitoring & management for ML/systems research",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "wiki:kinds:generate": "pnpm --filter @memon/core build && node scripts/wiki-kinds.mjs --write",
    "wiki:kinds:check": "pnpm --filter @memon/core build && node scripts/wiki-kinds.mjs --check",
    "components:docs:generate": "node scripts/component-docs.mjs --write",
    "components:docs:check": "node scripts/component-docs.mjs --check",
    "dev": "pnpm --filter @memon/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @memon/core build && pnpm --filter @memon/backend build && pnpm -r test",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format --write .",
    "validate:release": "pnpm --filter @memon/core build && node scripts/validate-release.mjs",
    "typecheck": "pnpm -r typecheck",
    "memon": "pnpm --filter @memon/cli memon",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "lefthook": "^1.7.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
