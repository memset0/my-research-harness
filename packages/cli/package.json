{
  "name": "@memon/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "memon": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "memon": "node ./dist/index.js"
  },
  "dependencies": {
    "@memon/backend": "workspace:*",
    "@memon/core": "workspace:*",
    "@memon/skills": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
