{
  "name": "@memon/skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "memon-*",
    "PREFLIGHT.md",
    "retired-skills.json"
  ],
  "scripts": {
    "build": "node ../../scripts/wiki-kinds.mjs --check && node ../../scripts/component-docs.mjs --check && node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/wiki-kinds.mjs --check && node ../../scripts/component-docs.mjs --check",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@memon/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
