{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./node_modules/.cache/tsbuild",
    "tsBuildInfoFile": "./node_modules/.cache/tsbuild/tsconfig.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@memon/core": ["../core/src/index.ts"],
      "@memon/test-utils": ["../test-utils/src/index.ts"],
      "@memon/file-protocol": ["../file-protocol/src/index.ts"],
      "@memon/file-protocol/*": ["../file-protocol/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../test-utils"
    },
    {
      "path": "../file-protocol"
    }
  ]
}
