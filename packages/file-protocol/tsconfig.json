{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./node_modules/.cache/tsbuild",
    "tsBuildInfoFile": "./node_modules/.cache/tsbuild/tsconfig.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@memon/test-utils": ["../test-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../test-utils"
    }
  ]
}
